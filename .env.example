# =====================================================================
# دعوت نیلو — Environment configuration example
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Generate secrets with:  npm run gen:secrets
# Generate an admin hash with:  npm run admin:hash -- 'YourStrongPassword'
# =====================================================================

# ---------- Core ----------
# PostgreSQL connection string.
DATABASE_URL="postgresql://nilou:nilou@localhost:5432/nilou?schema=public"

# Public base URL of the deployed app (used for links, ICS, etc.).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# App timezone. Kept for clarity; the code hard-defaults to Asia/Tehran.
APP_TIMEZONE="Asia/Tehran"

# Node environment (development | production | test)
NODE_ENV="development"

# ---------- Invitation identity ----------
# The public, non-guessable slug. Seed generates one if omitted.
INVITATION_SLUG=""
INVITEE_NAME="نیلو"
OWNER_NAME="مجید"

# Owner (Majid) contact number — shown ONLY after Nilou accepts.
# Not exposed via any NEXT_PUBLIC_ variable.
OWNER_PHONE_LOCAL="09129284402"
OWNER_PHONE_E164="+989129284402"

# ---------- Admin auth ----------
ADMIN_EMAIL="admin@example.com"
# Provide EITHER a bcrypt hash (preferred) …
#   generate: npm run admin:hash -- 'password'   (escape $ as \$ in this file)
ADMIN_PASSWORD_HASH=""
# … OR a plaintext password (hashed in memory at startup — easiest for Docker).
# Avoid '$' in the value so docker-compose doesn't try to interpolate it.
ADMIN_PASSWORD=""
# 32+ byte random secret used to sign admin session JWTs. Generate: npm run gen:secrets
SESSION_SECRET=""

# ---------- Postgres (used by docker-compose) ----------
POSTGRES_USER="nilou"
POSTGRES_PASSWORD="nilou"
POSTGRES_DB="nilou"

# ---------- Phone encryption ----------
# 32-byte key, base64-encoded, used for AES-256-GCM. Generate: npm run gen:secrets
# WARNING: rotating this makes previously-encrypted phone numbers undecryptable.
PHONE_ENCRYPTION_KEY=""

# ---------- Telegram (primary notification, optional) ----------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ---------- Email (fallback notification, optional) ----------
# EMAIL_PROVIDER: "smtp" enables email. Empty disables it.
EMAIL_PROVIDER=""
EMAIL_FROM="Daavat <no-reply@example.com>"
EMAIL_TO=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ---------- Build/runtime toggles ----------
# Set to "1" to skip strict env validation (used during `next build` / CI).
SKIP_ENV_VALIDATION=""
